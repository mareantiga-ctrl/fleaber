# Copiar ou gerar com: dart run tool/maestro_prepare_live.dart
MAESTRO_APP_ID=com.mycompany.fleaber
MAESTRO_LIVE_ID=00000000-0000-0000-0000-000000000000
MAESTRO_SELLER_ID=00000000-0000-0000-0000-000000000000
MAESTRO_BUYER_EMAIL=buyer@example.com
MAESTRO_BUYER_PASSWORD=your_password
MAESTRO_SELLER_EMAIL=seller@example.com
MAESTRO_SELLER_PASSWORD=your_password
MAESTRO_DEEP_LINK_BASE=fleaber://fleaber.com
# V1.5 multi-dispositivo (opcional; também em tool/live_ops_staging.env)
# TCL 20 Plus USB = adb serial (adb devices -l)
MAESTRO_DEVICE_SELLER=a698f0de
MAESTRO_DEVICE_BUYER=emulator-5556
MAESTRO_DEVICE_DEFAULT=a698f0de
MAESTRO_DRIVER_PORT_SELLER=7001
MAESTRO_DRIVER_PORT_BUYER=7002
MAESTRO_ITEM_TITLE=Maestro smoke item
