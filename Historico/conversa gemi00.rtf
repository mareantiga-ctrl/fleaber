No teu editor do Supabase (SQL Editor), vais precisar de criar esta fun\'e7\'e3o. A l\'f3gica \'e9: "Se a encomenda passar a 'Conclu\'edda' e n\'e3o houver review, cria uma autom\'e1tica."\par
SQL\par
\par
-- 1. Fun\'e7\'e3o que cria a review autom\'e1tica\par
CREATE OR REPLACE FUNCTION gerar_review_automatica()\par
RETURNS TRIGGER AS $$\par
BEGIN\par
    -- Verifica se j\'e1 existe uma review para esta encomenda\par
    IF NOT EXISTS (SELECT 1 FROM reviews WHERE order_id = NEW.id) THEN\par
        INSERT INTO reviews (\par
            seller_id, \par
            buyer_id, \par
            order_id, \par
            stars, \par
            comment, \par
            is_automatic, \par
            created_at\par
        )\par
        VALUES (\par
            NEW.seller_id,\par
            NEW.buyer_id,\par
            NEW.id,\par
            5, -- Rating m\'e1ximo para vendas autom\'e1ticas conclu\'eddas\par
            'Venda conclu\'edda com sucesso. Feedback autom\'e1tico do sistema Fleaber.',\par
            TRUE,\par
            NOW()\par
        );\par
    END IF;\par
    RETURN NEW;\par
END;\par
$$ LANGUAGE plpgsql;\par
\par
-- 2. Trigger que dispara quando o status da encomenda muda para 'concluido'\par
CREATE TRIGGER trigger_feedback_automatico\par
AFTER UPDATE OF status ON encomendas\par
FOR EACH ROW\par
WHEN (NEW.status = 'concluido')\par
EXECUTE FUNCTION gerar_review_automatica();\par
