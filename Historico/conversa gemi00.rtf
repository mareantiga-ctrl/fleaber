CREATE OR REPLACE FUNCTION get_seller_stats(p_seller_id UUID)\par
RETURNS TABLE (\par
    media_total NUMERIC,\par
    total_reviews BIGINT,\par
    media_membros NUMERIC,\par
    total_membros BIGINT,\par
    media_sistema NUMERIC,\par
    total_sistema BIGINT\par
) AS $$\par
BEGIN\par
    RETURN QUERY\par
    SELECT \par
        ROUND(AVG(stars)::numeric, 1) as media_total,\par
        COUNT(*) as total_reviews,\par
        ROUND(AVG(stars) FILTER (WHERE is_automatic = false)::numeric, 1) as media_membros,\par
        COUNT(*) FILTER (WHERE is_automatic = false) as total_membros,\par
        ROUND(AVG(stars) FILTER (WHERE is_automatic = true)::numeric, 1) as media_sistema,\par
        COUNT(*) FILTER (WHERE is_automatic = true) as total_sistema\par
    FROM reviews\par
    WHERE seller_id = p_seller_id;\par
END;\par
$$ LANGUAGE plpgsql;\par
