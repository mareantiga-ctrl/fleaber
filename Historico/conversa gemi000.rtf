Aqui tens o c\'f3digo "blindado" para a tua p\'e1gina de direto:\par
Dart\par
\par
import 'dart:math' as math;\par
import 'package:flutter/material.dart';\par
import 'package:google_fonts/google_fonts.dart';\par
import 'package:chewie/chewie.dart';\par
import 'package:video_player/video_player.dart';\par
\par
class FleaberLivePlayer extends StatefulWidget \{\par
  const FleaberLivePlayer(\{\par
    super.key,\par
    this.width,\par
    this.height,\par
    required this.playbackId,\par
  \});\par
\par
  final double? width;\par
  final double? height;\par
  final String playbackId;\par
\par
  @override\par
  State<FleaberLivePlayer> createState() => _FleaberLivePlayerState();\par
\}\par
\par
class _FleaberLivePlayerState extends State<FleaberLivePlayer> \{\par
  VideoPlayerController? _videoPlayerController;\par
  ChewieController? _chewieController;\par
\par
  @override\par
  void initState() \{\par
    super.initState();\par
    _initializePlayer();\par
  \}\par
\par
  void _initializePlayer() async \{\par
    // Formata o URL do Mux usando o playbackId recebido\par
    final url =\par
        'https://stream.mux.com/$\{widget.playbackId\}.m3u8';\par
    \par
    _videoPlayerController = VideoPlayerController.networkUrl(Uri.parse(url));\par
\par
    await _videoPlayerController!.initialize();\par
\par
    _chewieController = ChewieController(\par
      videoPlayerController: _videoPlayerController!,\par
      autoPlay: true,\par
      looping: true,\par
      showControls: false, // Esconde os controlos padr\'e3o para estilo TikTok\par
      aspectRatio: _videoPlayerController!.value.aspectRatio,\par
      errorBuilder: (context, errorMessage) \{\par
        return Center(\par
          child: Text(\par
            'Aguardando sinal do direto...',\par
            style: TextStyle(color: Colors.white),\par
          ),\par
        );\par
      \},\par
    );\par
    setState(() \{\});\par
  \}\par
\par
  @override\par
  void dispose() \{\par
    _videoPlayerController?.dispose();\par
    _chewieController?.dispose();\par
    super.dispose();\par
  \}\par
\par
  @override\par
  Widget build(BuildContext context) \{\par
    return Container(\par
      width: widget.width,\par
      height: widget.height,\par
      color: Colors.black,\par
      child: Stack(\par
        children: [\par
          // 1. CAMADA DO V\'cdDEO (FULLSCREEN)\par
          _chewieController != null &&\par
                  _chewieController!.videoPlayerController.value.isInitialized\par
              ? SizedBox.expand(\par
                  child: FittedBox(\par
                    fit: BoxFit.cover, // Faz o efeito Fullscreen/TikTok\par
                    child: SizedBox(\par
                      width: _videoPlayerController!.value.size.width,\par
                      height: _videoPlayerController!.value.size.height,\par
                      child: Chewie(controller: _chewieController!),\par
                    ),\par
                  ),\par
                )\par
              : const Center(\par
                  child: CircularProgressIndicator(color: Colors.red),\par
                ),\par
\par
          // 2. GRADIENTE PARA LEITURA (OPCIONAL MAS RECOMENDADO)\par
          Container(\par
            decoration: const BoxDecoration(\par
              gradient: LinearGradient(\par
                begin: Alignment.topCenter,\par
                end: Alignment.bottomCenter,\par
                colors: [\par
                  Colors.black38,\par
                  Colors.transparent,\par
                  Colors.transparent,\par
                  Colors.black54,\par
                ],\par
              ),\par
            ),\par
          ),\par
\par
          // 3. INTERFACE OVERLAY (Aqui podes adicionar os teus bot\'f5es de FF)\par
          // Nota: Como \'e9 um Custom Widget, o ideal \'e9 deixares o overlay \par
          // ser feito no FF por cima deste widget usando uma Stack.\par
        ],\par
      ),\par
    );\par
  \}\par
\}\par
