Copia e cola isto no teu SQL Editor do Supabase e clica em Run:\par
SQL\par
\par
-- 1. Adicionar colunas de Localiza\'e7\'e3o e Total de Directos \'e0 tabela profiles\par
ALTER TABLE public.profiles \par
ADD COLUMN IF NOT EXISTS location text DEFAULT 'Portugal',\par
ADD COLUMN IF NOT EXISTS total_lives int8 DEFAULT 0;\par
\par
-- 2. Criar a tabela de Seguidores (Followers)\par
CREATE TABLE IF NOT EXISTS public.follows (\par
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,\par
    follower_id uuid REFERENCES public.profiles(id) ON DELETE CASCADE, -- Quem segue\par
    following_id uuid REFERENCES public.profiles(id) ON DELETE CASCADE, -- Quem \'e9 seguido\par
    created_at timestamp with time zone DEFAULT now(),\par
    -- Impede que algu\'e9m siga a mesma pessoa duas vezes\par
    UNIQUE(follower_id, following_id) \par
);\par
\par
-- 3. Abrir a porta para o FlutterFlow ler e escrever nestas tabelas (Seguran\'e7a RLS)\par
ALTER TABLE public.follows ENABLE ROW LEVEL SECURITY;\par
\par
DROP POLICY IF EXISTS "Acesso Total Seguidores" ON public.follows;\par
CREATE POLICY "Acesso Total Seguidores" ON public.follows FOR ALL USING (true);\par
\par
-- 4. Criar uma "View" para contar seguidores automaticamente (Facilita a vida no FlutterFlow)\par
CREATE OR REPLACE VIEW v_seguidores_stats AS\par
SELECT \par
    following_id as profile_id,\par
    COUNT(*) as total_seguidores\par
FROM public.follows\par
GROUP BY following_id;\par
