    if (!_catalogScrollController.hasClients) return;\par
\par
    final rows = _catalogRows;\par
\par
    if (rows == null || rows.isEmpty) return;\par
\par
    final idx = index.clamp(0, rows.length - 1);\par
\par
    final target = (idx * _kCatalogStride).clamp(\par
\par
      _catalogScrollController.position.minScrollExtent,\par
\par
      _catalogScrollController.position.maxScrollExtent,\par
\par
    );\par
\par
    _catalogScrollController.jumpTo(target);\par
\par
  \}\par
