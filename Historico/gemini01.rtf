  // FUN\'c7\'c3O PARA ESCOLHER E ENVIAR MEDIA\par
  Future<void> pickMedia() async \{\par
    final XFile? media = await _picker.pickMedia();\par
    if (media != null) \{\par
      final bytes = await media.readAsBytes();\par
      final String fileName = '$\{DateTime.now().millisecondsSinceEpoch\}_$\{media.name\}';\par
      final String path = 'chat_uploads/$fileName';\par
\par
      // Faz o upload para o Supabase Storage (Bucket: chat_media)\par
      await SupaFlow.client.storage.from('chat_media').uploadBinary(path, bytes);\par
      \par
      // Pega o link p\'fablico\par
      final String publicUrl = SupaFlow.client.storage.from('chat_media').getPublicUrl(path);\par
\par
      // Envia como mensagem\par
      await ChatMessagesTable().insert(\{\par
        'sender_id': currentUserUid,\par
        'text': publicUrl, // Aqui podes depois ajustar para mostrar a imagem/v\'eddeo\par
        'chat_id': widget.chatId,\par
      \});\par
    \}\par
  \}\par
\par
  String getDisplayDate(DateTime dateTime) \{\par
    final now = DateTime.now();\par
    final today = DateTime(now.year, now.month, now.day);\par
    final yesterday = today.subtract(const Duration(days: 1));\par
    final dateToCheck = DateTime(dateTime.year, dateTime.month, dateTime.day);\par
\par
    if (dateToCheck == today) \{\par
      return 'Hoje';\par
    \} else if (dateToCheck == yesterday) \{\par
      return 'Ontem';\par
    \} else \{\par
      return DateFormat('dd/MM/yyyy').format(dateTime);\par
    \}\par
  \}\par
