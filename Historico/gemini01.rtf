  state text,\par
  image_urls text[],         -- Links das fotos\par
  list_on_marketplace boolean default false,\par
  available_for_live boolean default false,\par
  is_sold boolean default false\par
);\par
\par
-- 3. Ativar RLS (Seguran\'e7a)\par
alter table public.products enable row level security;\par
\par
-- 4. Pol\'edticas de Acesso\par
create policy "Qualquer um v\'ea produtos ativos" on public.products\par
  for select using (true);\par
\par
create policy "Vendedores inserem os seus produtos" on public.products\par
  for insert with check (auth.uid() = seller_id);\par
\par
create policy "Vendedores editam os seus produtos" on public.products\par
  for update using (auth.uid() = seller_id);\par
\par
-- 5. \'cdndice para rapidez na Live\par
create index if not exists idx_products_ref_code on public.products (ref_code);\par
