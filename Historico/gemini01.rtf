import 'dart:math' as math;\par
\par
String formatChatDate(DateTime messageTime) \{\par
  final now = DateTime.now();\par
  final difference = now.difference(messageTime);\par
\par
  if (difference.inHours < 24 && now.day == messageTime.day) \{\par
    // Menos de 24h e no mesmo dia: mostra a hora\par
    return "$\{messageTime.hour.toString().padLeft(2, '0')\}:$\{messageTime.minute.toString().padLeft(2, '0')\}";\par
  \} else if (difference.inHours < 48 && now.day != messageTime.day) \{\par
    // Entre 24h e 48h (ontem)\par
    return "Ontem";\par
  \} else \{\par
    // Mais de 48h: mostra "h\'e1 X dias"\par
    return "H\'e1 $\{difference.inDays\} dias";\par
  \}\par
\}\par
