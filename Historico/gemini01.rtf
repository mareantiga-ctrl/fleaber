class _ChatPageWidgetState extends State<ChatPageWidget> \{\par
  late ChatPageModel _model;\par
  final scaffoldKey = GlobalKey<ScaffoldState>();\par
\par
  @override\par
  void initState() \{\par
    super.initState();\par
    _model = createModel(context, () => ChatPageModel());\par
\par
    _model.inputMensagemTextController ??= TextEditingController();\par
    _model.inputMensagemFocusNode ??= FocusNode();\par
\par
    WidgetsBinding.instance.addPostFrameCallback((_) => safeSetState(() \{\}));\par
  \}\par
\par
  @override\par
  void dispose() \{\par
    _model.dispose();\par
    super.dispose();\par
  \}\par
\par
  String getDisplayDate(DateTime dateTime) \{\par
    final now = DateTime.now();\par
    final today = DateTime(now.year, now.month, now.day);\par
    final yesterday = today.subtract(const Duration(days: 1));\par
    final dateToCheck = DateTime(dateTime.year, dateTime.month, dateTime.day);\par
\par
    if (dateToCheck == today) \{\par
      return 'Hoje';\par
    \} else if (dateToCheck == yesterday) \{\par
      return 'Ontem';\par
    \} else \{\par
      return DateFormat('dd/MM/yyyy').format(dateTime);\par
    \}\par
  \}\par
\par
  @override\par
  Widget build(BuildContext context) \{\par
    return FutureBuilder<List<ProfilesRow>>(\par
      future: ProfilesTable().querySingleRow(\par
        queryFn: (q) => q.eqOrNull('id', widget.otherUserId),\par
      ),\par
      builder: (context, snapshot) \{\par
        if (!snapshot.hasData) \{\par
          return const Scaffold(body: Center(child: CircularProgressIndicator()));\par
        \}\par
        final otherUser = snapshot.data!.first;\par
\par
        return GestureDetector(\par
          onTap: () => FocusScope.of(context).unfocus(),\par
          child: Scaffold(\par
            key: scaffoldKey,\par
            backgroundColor: const Color(0xFFF5F5F5),\par
            appBar: AppBar(\par
              backgroundColor: Colors.white,\par
              automaticallyImplyLeading: false,\par
              leading: FlutterFlowIconButton(\par
                icon: const Icon(Icons.arrow_back_rounded, color: Color(0xFF007782), size: 24),\par
                onPressed: () => context.safePop(),\par
              ),\par
              title: Row(\par
                children: [\par
                  ClipOval(\par
                    child: Image.network(\par
                      otherUser.photoUrl ?? 'https://storage.googleapis.com/flutterflow-io-6f20.appspot.com/projects/fleaber-is3jpb/assets/default_avatar.png',\par
                      width: 38,\par
                      height: 38,\par
                      fit: BoxFit.cover,\par
                    ),\par
                  ),\par
                  const SizedBox(width: 10),\par
                  Text(otherUser.fullName ?? 'Membro', style: FlutterFlowTheme.of(context).titleMedium),\par
                ],\par
              ),\par
              elevation: 0,\par
            ),\par
            body: SafeArea(\par
              child: Column(\par
                children: [\par
                  Expanded(\par
                    child: StreamBuilder<List<ChatMessagesRow>>(\par
                      stream: _model.containerSupabaseStream ??= SupaFlow.client\par
                          .from("chat_messages")\par
                          .stream(primaryKey: ['id'])\par
                          .eqOrNull('chat_id', widget.chatId)\par
                          .order('created_at', ascending: true)\par
                          .map((list) => list.map((item) => ChatMessagesRow(item)).toList()),\par
                      builder: (context, snapshot) \{\par
                        if (!snapshot.hasData) return const Center(child: CircularProgressIndicator());\par
                        final messages = snapshot.data!;\par
                        return ListView.builder(\par
                          padding: const EdgeInsets.symmetric(vertical: 16),\par
                          itemCount: messages.length,\par
                          itemBuilder: (context, index) \{\par
                            final msg = messages[index];\par
                            final date = msg.createdAt ?? DateTime.now();\par
\par
                            bool showSeparator = false;\par
                            if (index == 0) \{\par
                              showSeparator = true;\par
                            \} else \{\par
                              final prevDate = messages[index - 1].createdAt;\par
                              if (prevDate != null && date.day != prevDate.day) \{\par
                                showSeparator = true;\par
                              \}\par
                            \}\par
\par
                            final bool isMe = msg.senderId == currentUserUid;\par
\par
                            return Column(\par
                              children: [\par
                                if (showSeparator)\par
                                  Padding(\par
                                    padding: const EdgeInsets.symmetric(vertical: 16),\par
                                    child: Container(\par
                                      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 4),\par
                                      decoration: BoxDecoration(color: const Color(0xFFE0E0E0), borderRadius: BorderRadius.circular(20)),\par
                                      child: Text(getDisplayDate(date), style: const TextStyle(color: Color(0xFF777777), fontSize: 11)),\par
                                    ),\par
                                  ),\par
                                Padding(\par
                                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),\par
                                  child: Align(\par
                                    alignment: isMe ? Alignment.centerRight : Alignment.centerLeft,\par
                                    child: Column(\par
                                      crossAxisAlignment: isMe ? CrossAxisAlignment.end : CrossAxisAlignment.start,\par
                                      children: [\par
                                        Container(\par
                                          constraints: BoxConstraints(maxWidth: MediaQuery.sizeOf(context).width * 0.7),\par
                                          decoration: BoxDecoration(\par
                                            color: isMe ? const Color(0xFF007782) : Colors.white,\par
                                            borderRadius: BorderRadius.circular(18),\par
                                          ),\par
                                          padding: const EdgeInsets.all(10),\par
                                          child: Text(msg.text ?? '', style: TextStyle(color: isMe ? Colors.white : Colors.black)),\par
                                        ),\par
                                        const SizedBox(height: 2),\par
                                        Text(DateFormat('HH:mm').format(date), style: const TextStyle(color: Color(0xFFAAAAAA), fontSize: 10)),\par
                                      ],\par
                                    ),\par
                                  ),\par
                                ),\par
                              ],\par
                            );\par
                          \},\par
                        );\par
                      \},\par
                    ),\par
                  ),\par
                  Container(\par
                    padding: const EdgeInsets.all(12),\par
                    color: Colors.white,\par
                    child: Row(\par
                      children: [\par
                        Expanded(\par
                          child: TextFormField(\par
                            controller: _model.inputMensagemTextController,\par
                            decoration: InputDecoration(hintText: 'Escreve...', border: OutlineInputBorder(borderRadius: BorderRadius.circular(25))),\par
                          ),\par
                        ),\par
                        const SizedBox(width: 10),\par
                        IconButton(\par
                          icon: const Icon(Icons.send_rounded, color: Color(0xFF007782)),\par
                          onPressed: () async \{\par
                            if (_model.inputMensagemTextController.text.isEmpty) return;\par
                            await ChatMessagesTable().insert(\{'sender_id': currentUserUid, 'text': _model.inputMensagemTextController.text, 'chat_id': widget.chatId\});\par
                            _model.inputMensagemTextController.clear();\par
                          \},\par
                        ),\par
                      ],\par
                    ),\par
                  ),\par
                ],\par
              ),\par
            ),\par
          ),\par
        );\par
      \},\par
    );\par
  \}\par
