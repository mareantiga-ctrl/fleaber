-- Criar o bucket de media para o chat\par
insert into storage.buckets (id, name, public)\par
values ('chat_media', 'chat_media', true);\par
\par
-- Permitir que qualquer pessoa veja as fotos (Pol\'edtica de Leitura)\par
create policy "Fotos do chat s\'e3o p\'fablicas"\par
on storage.objects for select\par
using ( bucket_id = 'chat_media' );\par
\par
-- Permitir que users autenticados fa\'e7am upload\par
create policy "Users podem fazer upload de fotos"\par
on storage.objects for insert\par
with check (\par
  bucket_id = 'chat_media' \par
  and auth.role() = 'authenticated'\par
);\par
