\par
Apaga tudo o que tens no SQL Editor e cola este c\'f3digo completo. Este script cria a tabela, define as colunas e as regras de seguran\'e7a (RLS) de uma s\'f3 vez:\par
SQL\par
\par
-- 1. Criar a tabela de produtos do zero\par
create table if not exists public.products (\par
  id uuid primary key default gen_random_uuid(),\par
  created_at timestamptz default now(),\par
  seller_id uuid references auth.users(id) default auth.uid(),\par
  title text,\par
  price numeric,\par
  reference text,\par
  category text,\par
  size text,\par
  gender text,\par
  description text,\par
  state text,\par
  image_urls text[], -- Para guardarmos os links das fotos\par
  list_on_marketplace boolean default false,\par
  available_for_live boolean default false,\par
  is_sold boolean default false\par
);\par
\par
-- 2. Ativar Seguran\'e7a (RLS)\par
alter table public.products enable row level security;\par
\par
-- 3. Criar Pol\'edticas de Acesso\par
-- Criar: S\'f3 utilizadores autenticados podem criar os seus produtos\par
create policy "Vendedores podem criar produtos" \par
on public.products for insert \par
with check (auth.uid() = seller_id);\par
\par
-- Ler: Todos podem ver produtos do Marketplace ou o pr\'f3prio dono\par
create policy "Ver produtos p\'fablicos ou pr\'f3prios" \par
on public.products for select \par
using (list_on_marketplace = true or auth.uid() = seller_id);\par
\par
-- Editar/Apagar: S\'f3 o dono do produto\par
create policy "Dono pode editar ou apagar" \par
on public.products for all \par
using (auth.uid() = seller_id);\par
\par
-- 4. Criar \'edndice para a refer\'eancia (para ser r\'e1pido na Live)\par
create index if not exists idx_products_reference on public.products (reference);\par
