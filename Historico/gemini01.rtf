Aqui tens o script SQL para correres no SQL Editor do teu Supabase. Ele vai criar a tabela de artigos da live e a fun\'e7\'e3o para o vendedor "mudar de produto" em tempo real.\par
\f1\u-10179?\u-8480?\f2  \f0 SQL para o Supabase (Fleaber Live Items)\par
SQL\par
\par
-- 1. Tabela para os artigos que v\'e3o ser vendidos na live\par
CREATE TABLE IF NOT EXISTS public.live_items (\par
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,\par
    live_id uuid REFERENCES public.lives(id) ON DELETE CASCADE,\par
    seller_id uuid REFERENCES auth.users(id),\par
    \par
    -- Dados do Artigo (como falaste, muitos s\'e3o opcionais)\par
    ref_code text NOT NULL, -- O c\'f3digo alfanum\'e9rico (\'fanico obrigat\'f3rio)\par
    title text,\par
    description text,\par
    price decimal DEFAULT 0.00,\par
    image_url text,\par
    size text,\par
    color text,\par
    \par
    -- Controlo de Fluxo\par
    is_active boolean DEFAULT false, -- Define se \'e9 o item que est\'e1 a ser mostrado agora\par
    order_index int DEFAULT 0,       -- Para a ordena\'e7\'e3o num\'e9rica que pediste\par
    status text DEFAULT 'available', -- 'available', 'sold', 'reserved'\par
    \par
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now())\par
);\par
\par
-- 2. Fun\'e7\'e3o para o vendedor trocar o artigo ativo (Ponto 7.1)\par
-- Esta fun\'e7\'e3o garante que apenas UM artigo est\'e1 ativo de cada vez na live\par
CREATE OR REPLACE FUNCTION public.set_active_live_item(target_item_id uuid, target_live_id uuid)\par
RETURNS void AS $$\par
BEGIN\par
    -- Desativa todos os itens dessa live\par
    UPDATE public.live_items \par
    SET is_active = false \par
    WHERE live_id = target_live_id;\par
\par
    -- Ativa apenas o selecionado\par
    UPDATE public.live_items \par
    SET is_active = true \par
    WHERE id = target_item_id;\par
END;\par
$$ LANGUAGE plpgsql;\par
\par
-- 3. Habilitar Realtime para que os compradores vejam o card mudar instantaneamente\par
ALTER PUBLICATION supabase_realtime ADD TABLE public.live_items;\par
\par
O que este SQL resolve:\par
