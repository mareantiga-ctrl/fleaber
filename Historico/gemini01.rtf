ALTER COLUMN is_reservation SET DEFAULT FALSE;\par
\par
-- 3. Atualiza as mensagens antigas para que nada fique vazio (opcional mas recomendado)\par
UPDATE public.chat_messages SET is_read = FALSE WHERE is_read IS NULL;\par
UPDATE public.chat_messages SET is_reservation = FALSE WHERE is_reservation IS NULL;\par
\par
