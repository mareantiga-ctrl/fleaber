#!/bin/bash
# Instala só a chave pública Fleaber DPD. Apagar do site após usar.
set -e
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
grep -q 'fleaber-dpd-proxy-ovh' "$HOME/.ssh/authorized_keys" 2>/dev/null || \
  echo 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPWdI+DB4nECvumkrfbxrL7gYNZ2bthlzhECJ5Lepz74 fleaber-dpd-proxy-ovh' >> "$HOME/.ssh/authorized_keys"
chmod 600 "$HOME/.ssh/authorized_keys"
echo CHAVE_OK
