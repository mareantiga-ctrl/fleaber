# Extensão para tool/live_ops_staging.env (bot simulator)
# Copiar linhas relevantes para tool/live_ops_staging.env

# OBRIGATÓRIO: ref do projecto staging (ver URL Supabase)
# Ex: https://abcdefgh.supabase.co → abcdefgh
BOT_SIM_ALLOWED_PROJECT_REFS=your_staging_project_ref

# Alternativa dev local (menos seguro):
# BOT_SIM_ALLOW_ANY_STAGING=true

# Domínio email dos bots (não usar domínio real de clientes)
BOT_SIM_EMAIL_DOMAIN=staging.fleaber.bot
BOT_SIM_DEFAULT_PASSWORD=change_me_staging_only

# Opcional: URL web para --observe-ui ({live_id} substituído)
# FLEABER_LIVE_WEB_URL=https://staging.fleaber.app/live/{live_id}
