# Copiar para tool/live_ops_staging.env (não commitar).
# Usar o MESMO projeto Supabase onde corre live_ops_hotfix_batata.sql

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Perfis existentes em auth.users / profiles (vendedor + comprador de teste)
LIVE_OPS_TEST_SELLER_ID=00000000-0000-0000-0000-000000000001
LIVE_OPS_TEST_BUYER_ID=00000000-0000-0000-0000-000000000002

# Login comprador/vendedor (para RPCs que exigem auth.uid())
LIVE_OPS_TEST_BUYER_EMAIL=buyer-test@example.com
LIVE_OPS_TEST_BUYER_PASSWORD=your_test_password
LIVE_OPS_TEST_SELLER_EMAIL=seller-test@example.com
LIVE_OPS_TEST_SELLER_PASSWORD=your_test_password
