          "sellerFlow": ".maestro/flows/stock_lc_seller_session.yaml",
          "sellerHint": "Seller: login + studio catálogo."
        },
        {
          "id": "A3",
          "sellerFlow": ".maestro/flows/stock_lc_seller_cycle1.yaml",
          "sellerHint": "Seller: Aceitar → +stock → edit qty.",
          "bdScenario": "verify_maestro_accepted"
        },
        {
          "id": "A4",
          "buyerFlow": ".maestro/flows/stock_lc_buyer_res_cancel_res.yaml",
