      "surfaces": ["gravado_replay", "marketplace_pdp", "seller_catalog"],
      "automation": "bd_batch",
      "bdBatch": "tool/stock_lifecycle_bd_batch.dart",
      "registryId": "T32"
    },
    {
      "id": "SL-C",
      "name": "Mensagens — humanizer + emissores + live session",
      "matrixIds": ["M01-M23", "A294"],
      "action": "flutter test humanizer + message_battery emitters + audit live_messages",
      "surfaces": ["public_chat", "buyer_bag", "seller_operacao"],
      "automation": "messages_batch",
      "messageSteps": [
        { "cmd": "flutter", "args": ["test", "test/message_battery_humanizer_test.dart"] },
        { "cmd": "dart", "args": ["run", "tool/message_battery.dart", "--area", "emitters", "--keep"] },
        { "cmd": "dart", "args": ["run", "tool/message_battery.dart", "--area", "reservation_state", "--keep"] },
        { "cmd": "dart", "args": ["run", "tool/message_battery.dart", "--area", "order_state", "--keep"] },
        { "cmd": "dart", "args": ["run", "tool/message_battery.dart", "--area", "dm", "--keep"] },
        { "cmd": "dart", "args": ["run", "tool/stock_lifecycle_live_messages.dart"] }
      ],
      "registryId": "T40"
    },
    {
      "id": "SL-D",
      "name": "Auditoria holística — todos prints/logs vs BD + heurísticas",
      "matrixIds": ["audit_all"],
      "action": "Varre pasta evidência: técnico, redundância, humanização, qty UI↔BD",
      "surfaces": ["all"],
      "automation": "deep_audit",
      "deepAudit": "tool/stock_lifecycle_deep_audit.dart",
      "registryId": "T41"
    },
