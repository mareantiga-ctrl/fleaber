  "screenshotRoot": "tool/logs/stock_lifecycle_{stamp}",
  "coverageMatrix": "tool/stock_lifecycle_coverage.json",
  "devices": {
    "seller": "emulator-5554",
    "buyer": "emulator-5556"
  },
