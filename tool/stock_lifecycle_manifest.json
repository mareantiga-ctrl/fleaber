        {
          "id": "E2",
          "buyerFlow": ".maestro/flows/stock_lc_edge_buyer_waitlist.yaml",
          "buyerHint": "Buyer: saco — verifica posição na fila / waitlist."
        }
      ],
      "checkpointAudit": true
    },
    {
      "id": "SL-F",
      "name": "Hub publish — handle + vitrine pública",
      "matrixIds": ["H12", "batata_publish_hub"],
      "action": "dart run tool/hub_publish_staging_functional.dart",
      "surfaces": ["hub_vitrine", "seller_profile"],
      "automation": "hub_functional",
      "hubScript": "tool/hub_publish_staging_functional.dart",
      "registryId": "T43"
    },
    {
      "id": "SL-G",
      "name": "Cross-pool UI — live carrossel + gravado + marketplace",
      "matrixIds": ["A340", "A343", "A349", "A350", "A351", "A352", "A146"],
      "action": "Seed cross pool + Maestro buyer em 3 superfícies",
      "surfaces": ["buyer_carousel", "gravado_replay", "marketplace_pdp"],
      "automation": "cross_pool_ui",
      "preStep": "cross_pool_ui_seed",
      "postStep": "restore_env",
      "registryId": "T44",
      "uxSteps": [
        {
          "id": "G1",
          "buyerFlow": ".maestro/flows/stock_lc_cross_buyer_carousel.yaml",
          "buyerHint": "Buyer: player live cross — Disp no carrossel.",
          "bdScenario": "maestro_live_stock"
        },
        {
          "id": "G2",
          "buyerFlow": ".maestro/flows/stock_lc_cross_buyer_gravado.yaml",
          "buyerHint": "Buyer: perfil → gravados → player GRAVADO."
        },
        {
          "id": "G3",
          "buyerFlow": ".maestro/flows/stock_lc_cross_buyer_marketplace.yaml",
          "buyerHint": "Buyer: Marketplace → card produto → PDP qty."
        }
      ],
      "checkpointAudit": true
    }
  ]
