          "bdScenario": "verify_maestro_rejected"
        },
        {
          "id": "A5",
          "sellerFlow": ".maestro/flows/stock_lc_seller_cycle2.yaml",
          "sellerHint": "Seller: Aceitar → Vendido → +10 stock.",
          "bdScenario": "verify_maestro_accepted"
        },
        {
          "id": "A6",
          "buyerFlow": ".maestro/flows/stock_lc_buyer_verify.yaml",
          "buyerHint": "Buyer: carrossel final — Disp/Total vs seller."
        }
      ],
      "postBd": "maestro_live_stock",
      "checkpointAudit": true
    },
    {
      "id": "SL-B",
      "name": "BD batch — cross-pool, gravado, marketplace, A3/R32 fixture",
      "matrixIds": ["A340", "A341", "A342", "A343", "A344", "A349", "T04", "T05"],
